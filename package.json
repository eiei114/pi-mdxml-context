{
  "name": "pi-mdxml-context",
  "version": "0.1.21",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "version:check": "node scripts/check-version-bump.mjs"
  },
  "dependencies": {
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.2",
    "@types/node": "^24.19.1",
    "typescript": "^5.9.0",
    "@earendil-works/pi-agent-core": "^0.99.2",
    "@earendil-works/pi-ai": "^0.99.2",
    "@earendil-works/pi-tui": "^0.99.2"
  },
  "license": "MIT",
  "description": "Pi extension that converts Markdown context to XML-like structure at model send time",
  "keywords": [
